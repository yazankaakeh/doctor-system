APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mps
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Laravel Reverb (Real-time WebSockets)
REVERB_APP_ID=base-project
REVERB_APP_KEY=base-project-key
REVERB_APP_SECRET=base-project-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Demo Mode Configuration
DEMO_MODE=false
DEMO_DOCTOR_EMAIL=doctor@demo.com
DEMO_DOCTOR_PASSWORD=password
DEMO_PATIENT_EMAIL=patient@demo.com
DEMO_PATIENT_PASSWORD=password
DEMO_ADMIN_EMAIL=admin@demo.com
DEMO_ADMIN_PASSWORD=password

SMS_USERNAME=5322305681
SMS_PASSWORD=123654
SMS_URL=http://panel.1telekom.com.tr/Api/Submit

ZIRAAT_MERCHANT_ID=
ZIRAAT_TERMINAL_ID=
ZIRAAT_PROVISION_URL=
ZIRAAT_INIT_URL=
ZIRAAT_PROVISION_PASSWORD=

VAKIF_MERCHANT_ID=
VAKIF_TERMINAL_ID=
VAKIF_PROVISION_URL=
VAKIF_INIT_URL=
VAKIF_PROVISION_PASSWORD=

GARANTI_MERCHANT_ID=
GARANTI_TERMINAL_ID=
GARANTI_PROVISION_URL=
GARANTI_INIT_URL=
GARANTI_PROVISION_PASSWORD=

YAPIKREDI_MERCHANT_ID=
YAPIKREDI_TERMINAL_ID=
YAPIKREDI_PROVISION_URL=
YAPIKREDI_INIT_URL=
YAPIKREDI_PROVISION_PASSWORD=

BROWSERSHOT_NODE_PATH=/usr/bin/node
BROWSERSHOT_NPM_PATH=/usr/bin/npm
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
PUPPETEER_CACHE_DIR=/home/yupcrm-doctor/.cache/puppeteer

# Video Consultation (Jitsi)
VIDEO_PROVIDER=jitsi
JITSI_DOMAIN=meet.yupcrm.com
# For public meet.jit.si, leave APP_ID and SECRET empty
# For self-hosted or 8x8 JaaS, configure these for JWT authentication
JITSI_APP_ID=
JITSI_SECRET=
JITSI_SELF_HOSTED=false
# Note: Lobby features require JWT authentication (APP_ID & SECRET)
# For public meet.jit.si without JWT, lobby is automatically disabled
VIDEO_ROOM_PREFIX=MedConsult
VIDEO_LOBBY_ENABLED=false
VIDEO_PASSWORD_PROTECTED=false
VIDEO_RECORDING_ENABLED=false
