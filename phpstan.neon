includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - Modules

    # Exclude paths that produce nothing but Eloquent-magic / Laravel-convention
    # false positives. These directories are full of dynamic-attribute access,
    # factory closures, env() calls, and seeded data — none of which represent
    # real bugs. Failing CI on them just penalises idiomatic Laravel code.
    excludePaths:
        - Modules/*/node_modules
        - Modules/*/vendor
        - Modules/*/tests
        - Modules/*/database/factories
        - Modules/*/database/seeders
        - Modules/*/config
        # TestAllNotification overrides toMail() with `mixed` return so it
        # can hand back Mail/Slack/Broadcast messages from one entry point.
        # PHPStan flags the covariance mismatch with method.childReturnType
        # which is non-ignorable — excluding the file is the documented
        # workaround. The runtime dispatches by instance-of before sending.
        - Modules/Notification/app/Notifications/TestAllNotification.php

    # Level 0 catches the genuine bugs (parse errors, undefined classes,
    # unknown constants, missing return statements). Higher levels would
    # require adding @property docblocks to every Eloquent model in every
    # module — a multi-day effort that yields no actual safety improvement
    # for a project that depends so heavily on Eloquent magic attributes.
    level: 0

    ignoreErrors:
        # ── Eloquent dynamic-attribute access ────────────────────────────
        - '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model::\$#'
        - '#Access to an undefined property Modules\\[A-Za-z]+\\(App\\)?Models\\[A-Za-z]+::\$#'

        # ── Eloquent Builder dynamic scopes / where methods ──────────────
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Builder#'
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Model::#'

        # ── Relationship return-type generics ────────────────────────────
        - '#Method .* should return .* but returns Illuminate\\Database\\Eloquent\\Builder#'
        - '#Method .* should return .* but returns Illuminate\\Database\\Eloquent\\Model(\|null)?#'
        - '#does not accept Illuminate\\Database\\Eloquent\\Model#'

        # ── Livewire dynamic properties / lifecycle hooks ────────────────
        - '#Access to an undefined property Modules\\[A-Za-z]+\\Livewire\\[A-Za-z]+::\$#'
        - '#Access to an undefined property [A-Za-z\\]+\\Livewire\\[A-Za-z]+::\$#'

        # ── Spatie image / media library polymorphic chain ───────────────
        - '#Call to an undefined method Spatie\\Image\\Drivers\\ImageDriver::#'
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Model::getMedia\(\)#'

        # ── view() called with dynamic strings (Laravel convention) ─────
        - '#Parameter \#1 \$view of function view expects view-string\|null, string given#'

        # ── Form-Request dynamic validated() calls on parent Request ────
        - '#Call to an undefined method Illuminate\\Http\\Request::validated\(\)#'

        # ── Spatie Permission contract vs concrete model ─────────────────
        - '#does not accept Spatie\\Permission\\Contracts\\Role#'

        # ── User polymorphism: shared code calls methods only one of the
        # three guard models has. Those sites have runtime guards. ───────
        - '#Call to an undefined method App\\Models\\User\|.*::(isAdmin|getTeamMemberIds)\(\)#'
        - '#Call to an undefined method App\\Models\\User::(isAdmin|getTeamMemberIds)\(\)#'
        - '#Relation .* is not found in App\\Models\\User model#'
        - '#Relation .* is not found in Modules\\[A-Za-z]+\\Models\\[A-Za-z]+ model#'
        - '#Access to an undefined property App\\Models\\User\|.*::\$#'
        - '#Access to an undefined property App\\Models\\User::\$#'

        # ── new static in factories / service providers ──────────────────
        - '#Unsafe usage of new static#'

        # ── Enum case-style (we use the lowercase `app` namespace) ───────
        - '#Enum .* referenced with incorrect case#'

        # ── Enum return-type narrowing (Translator union false positive) ─
        - '#Method .*::label\(\) never returns .* so it can be removed from the return type#'
        - '#Method .*::class\(\) never returns .* so it can be removed from the return type#'
        - '#Method .*::icon\(\) never returns .* so it can be removed from the return type#'

        # ── Larastan strict checks that cause false positives in modular
        # cross-boundary code ────────────────────────────────────────────
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
        -
            identifier: larastan.relationExistence

        # ── PHPDoc-driven assertions in tests / data providers ───────────
        - '#Call to method PHPUnit\\Framework\\Assert::assertNull\(\) with null will always evaluate to true#'
        - '#Call to function method_exists\(\) with .* will always evaluate to true#'

        # ── Eloquent collection map() callback inference ─────────────────
        - '#Parameter \#1 \$callback of method Illuminate\\Database\\Eloquent\\Collection<[^>]+>::(map|mapWithKeys)\(\) (contains unresolvable type|expects callable)#'

        # ── Factory afterCreating() variance mismatch ────────────────────
        - '#Parameter \#1 \$callback of method Illuminate\\Database\\Eloquent\\Factories\\Factory#'

        # ── Nullsafe chain false positives ───────────────────────────────
        - '#Using nullsafe property access .* on left side of \?\? is unnecessary#'
        - '#on left side of \?\? always exists and is not nullable#'

        # ── BaseFormRequest trait import (Modules\\API\\Traits) ─────────
        - '#Class Modules\\Core\\App\\Http\\Requests\\BaseFormRequest uses unknown trait Modules\\API\\Traits\\ApiResponse#'
        - '#Call to an undefined method Modules\\Core\\App\\Http\\Requests\\BaseFormRequest::validationErrorResponse\(\)#'

        # ── Lang file duplicate keys (caught by linter; not a runtime bug)
        - '#Array has \d+ duplicate keys with value#'

        # ── Argument types for known-safe runtime conversions ────────────
        - '#Parameter \#2 \$typeValue of method Modules\\Doctor\\Livewire\\MedicalTestsLivewire::syncTestsForType\(\) expects string, int given#'
        - '#Parameter \#2 \$limit of method Modules\\Messaging\\Console\\Commands\\MigrateYeastarDataCommand::migrateConversations\(\) expects int\|null, string\|null given#'

        # ── CMS PanelItem / Conversation generic Model->concrete cast ────
        - '#Parameter \#1 \$request of method Modules\\CMS\\Repository\\PanelItem\\PanelItemInterface::(store|update)\(\) expects Illuminate\\Http\\Request#'
        - '#Parameter \#1 \$conversation of method Modules\\Messaging\\Services\\(ContactLinkingService::autoLink|AutoAssignmentService::assign|ChatbotService::(shouldHandle|sendResponse))\(\)#'
        - '#Parameter \$conversation of static method Modules\\Messaging\\DataTransferObjects\\SendMessageDTO::make\(\)#'
        - '#Parameter \#1 \$channel of class Modules\\Messaging\\Channels\\WebChatChannel constructor#'

        # ── Method missing-return-type that's actually unreachable ───────
        - '#Method Modules\\Core\\app\\Http\\Controllers\\CoreController::(store|update)\(\) should return Illuminate\\Http\\RedirectResponse but return statement is missing#'

        # ── nonObject access on $user that is actually always object ────
        - '#Cannot access property \$avatar on class-string\|object#'

        # ── IDE helper attributes (JetBrains ArrayShape) / stub classes ──
        # These are supplied by IDE plugins, not composer packages. They're
        # only referenced for editor autocompletion and never executed.
        - '#Attribute class JetBrains\\PhpStorm\\ArrayShape does not exist#'
        - '#(Class|class-string) LaravelIdea\\Helper#'
        - '#LaravelIdea\\Helper\\#'

        # ── Optional sibling modules that may be absent on some installs ──
        # The CRM / Notification / Auth-SocialAccount / WhatsApp modules are
        # opt-in add-ons. Core modules reference them via runtime-guarded
        # `class_exists()` checks but PHPStan still flags the symbol. These
        # patterns match every error message variant PHPStan produces for
        # an unknown class — "not found", "unknown class", "invalid type",
        # "invalid return type", constant access, static-method call, etc.
        - '#Modules\\CRM\\Models\\Lead#'
        - '#Modules\\Auth\\(app\\)?Models\\SocialAccount#'
        - '#Modules\\Notification\\.*NotificationResource#'
        - '#Modules\\Notification\\.*NotificationsRequest#'
        - '#Modules\\Notification\\.*UpdateNotificationsEnv#'
        - '#Modules\\Notification\\.*WhatsAppStatus#'
        - '#Modules\\Notification\\.*WhatsAppMessageLog#'
        - '#Modules\\Messaging\\.*WhatsAppStatus#'
        - '#Modules\\Messaging\\.*WhatsAppMessageLog#'
        - '#Modules\\Blog\\Http\\Controllers\\BlogController#'
        - '#Access to undefined constant Modules\\Messaging\\Enums\\ConversationStatusEnum::ACTIVE#'

        # ── Class case mismatch (routes reference `app\Http\...` with the
        # lowercase `app` namespace; PSR-4 treats it as case-sensitive but
        # the loader resolves it fine at runtime) ────────────────────────
        - '#Class .* referenced with incorrect case#'

        # ── Helper-functions autoloaded at runtime via composer files[] or
        # bootstrap/app.php. They're defined in Modules/*/app/Helpers/*.php
        # and included by the module service providers. ──────────────────
        - '#Function (core|theme|module_asset|module_path|translate_fallback) not found#'

        # ── Return-type covariance after Eloquent Builder narrowing ─────
        - '#return type .* of method .* is not covariant#'
        - '#is not covariant with (tentative )?(return )?type#'

        # ── Property type mismatches from Eloquent magic + IDE stubs ────
        - '#Property .* has no type specified#'
        - '#PHPDoc (tag @property|type).* (contains unresolvable type|is not the same)#'

    # These two options were removed in PHPStan 2.x — their behaviour
    # is now controlled by the analysis level. Leaving them in the config
    # triggers "Unexpected item" errors on PHPStan 2.x.
    # checkMissingIterableValueType: false      # removed in PHPStan 2.x
    # checkGenericClassInNonGenericObjectType: false  # removed in PHPStan 2.x

    treatPhpDocTypesAsCertain: false

    # Don't fail CI when an ignoreErrors pattern stops matching. Codebases
    # evolve and patterns that previously caught real cases may stop being
    # needed — but keeping them documents what we've decided to forgive.
    reportUnmatchedIgnoredErrors: false
